VERSION = @VERSION@
TAG = @TAG@
SOURCE_ROOT = @SOURCE_ROOT@
BUILD_ROOT = @BUILD_ROOT@

all:
	ninja -C $(BUILD_ROOT)

install:
	ninja -C $(BUILD_ROOT) install

uninstall:
	ninja -C $(BUILD_ROOT) uninstall

clean:
	ninja -C $(BUILD_ROOT) clean

run: all
	PIPEWIREAO_SPA_PLUGIN_DIR=$(BUILD_ROOT)/spa/plugins \
	SPA_DATA_DIR=$(SOURCE_ROOT)/spa/plugins \
	PIPEWIREAO_MODULE_DIR=$(BUILD_ROOT)/src/modules \
	PATH=$(BUILD_ROOT)/src/examples:$(PATH) \
	PIPEWIREAO_CONFIG_DIR=$(BUILD_ROOT)/src/daemon \
	ACP_PATHS_DIR=$(SOURCE_ROOT)/spa/plugins/alsa/mixer/paths \
	ACP_PROFILES_DIR=$(SOURCE_ROOT)/spa/plugins/alsa/mixer/profile-sets \
	PIPEWIREAO_LOG_SYSTEMD=false \
	$(DBG) $(BUILD_ROOT)/src/daemon/pipewire-ao-uninstalled

gdb:
	$(MAKE) run DBG=gdb

valgrind:
	$(MAKE) run DBG="DISABLE_RTKIT=1 PIPEWIREAO_DLCLOSE=false valgrind --trace-children=yes --leak-check=full"

test: all
	ninja -C $(BUILD_ROOT) test

benchmark: all
	ninja -C $(BUILD_ROOT) benchmark

monitor: all
	PIPEWIREAO_SPA_PLUGIN_DIR=$(BUILD_ROOT)/spa/plugins \
	SPA_DATA_DIR=$(SOURCE_ROOT)/spa/plugins \
	PIPEWIREAO_MODULE_DIR=$(BUILD_ROOT)/src/modules/ \
	$(BUILD_ROOT)/src/tools/pwao-mon

cli: all
	PIPEWIREAO_SPA_PLUGIN_DIR=$(BUILD_ROOT)/spa/plugins \
	SPA_DATA_DIR=$(SOURCE_ROOT)/spa/plugins \
	PIPEWIREAO_MODULE_DIR=$(BUILD_ROOT)/src/modules/ \
	$(BUILD_ROOT)/src/tools/pwao-cli

shell: all
	ninja -C $(BUILD_ROOT) pipewire-ao-uninstalled

dist: all
	git archive --prefix=pipewire-ao-$(VERSION)/ -o pipewire-ao-$(VERSION).tar.gz $(TAG)

rpm: dist
	rpmbuild -ta pipewire-ao-$(VERSION).tar.gz

publish: all
	git branch -D gh-pages 2>/dev/null || true && \
	git branch -D draft 2>/dev/null || true && \
	git checkout -b draft && \
	git add -f $(BUILD_ROOT)/doc/html && \
	git commit -anm "Deploy on gh-pages" && \
	git subtree split --prefix $(BUILD_ROOT)/doc/html -b gh-pages && \
	git push --force origin gh-pages:gh-pages && \
	git checkout work 2>/dev/null
